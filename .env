# .env.common.example
# ⚠ 이 파일은 예시입니다.
# '.env.common'로 이름을 바꾸고
# 프로젝트에 맞게 값을 입력하여 사용하세요.

# Redis
SPRING_REDIS_PORT=6379

# Database
MYSQL_DATABASE=example
POSTGRESQL_DATABASE=example

# Schema
POSTGRESQL_SCHEMA=public

# docker-compose
MYSQL_ROOT_PASSWORD=password
POSTGRES_PASSWORD=password

# JWT SecretKey
JWT_SECRET_KEY=


# .env.dev.example
# ⚠ 이 파일은 예시입니다.
# '.env.dev'로 이름을 바꾸고
# 프로젝트에 맞게 값을 입력하여 사용하세요.

# MySQL
SPRING_DATASOURCE_URL_MYSQL=jdbc:mysql://localhost:3307/example?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME_MYSQL=root
SPRING_DATASOURCE_PASSWORD_MYSQL=rootpwd

# PostgreSQL
SPRING_DATASOURCE_URL_POSTGRESQL=jdbc:postgresql://localhost:5432/example
SPRING_DATASOURCE_USERNAME_POSTGRESQL=postgres
SPRING_DATASOURCE_PASSWORD_POSTGRESQL=password

# H2
SPRING_DATASOURCE_URL_H2=jdbc:h2:mem:testdb  # MYSQL 사용 시 MODE=MYSQL 설정을 추가해야 h2에서 mysql 쿼리가 정상적으로 작동
SPRING_DATASOURCE_USERNAME_H2=username
SPRING_DATASOURCE_PASSWORD_H2=password

# Redis
SPRING_REDIS_HOST=localhost

# Spring
SPRING_PROFILES_ACTIVE=dev



